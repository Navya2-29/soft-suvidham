{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "mega": {
      "projectType": "application",
      "schematics": {},
      "i18n": {
        "sourceLocale":"en",
        "locales": {
          "es":"src/assets/i18n/en.json",
          "ml":"src/assets/i18n/ml.json",
          "tm":"src/assets/i18n/tm.json",
          "hn":"src/assets/i18n/hn.json"

        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
           
            "outputPath": "dist/mega",
            
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.css",
              "src/assets/css/bootstrap.css",
              "node_modules/ngx-toastr/toastr.css"
              
            ],
           
            "scripts": [   
              
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "30kb",
                  "maximumError": "50kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json" 
          },
          "configurations": {
            "production": {
              "buildTarget": "mega:build:production"
            },
            "development": {
              "buildTarget": "mega:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "mega:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.css",
              "src/assets/bootstrap.css",
              "node_modules/ngx-toastr/toastr.css"
            ],
            "scripts": [
               "node_modules/html2pdf.js/dist/html2pdf.js"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}